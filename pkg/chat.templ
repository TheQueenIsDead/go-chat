package pkg

templ Index() {
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>Go Chat</title>
        <!-- Datastar -->
        <script type="module" src="/assets/datastar/v1.0.2/datastar.js"></script>
        <!-- Basecoat -->
        <link rel="stylesheet" href="/assets/basecoat/0.3.1/basecoat.cdn.min.css"/>
        <script src="/assets/basecoat/0.3.1/all.min.js" defer></script>
        <!-- Tailwind -->
        <script src="/assets/tailwindcss/v4.3.3/index.global.js"></script>
        <style type="text/tailwindcss">
            @theme inline {
                --color-background: var(--background);
                --color-foreground: var(--foreground);
                --color-card: var(--card);
                --color-card-foreground: var(--card-foreground);
                --color-muted: var(--muted);
                --color-muted-foreground: var(--muted-foreground);
                --color-accent: var(--accent);
                --color-border: var(--border);
            }
        </style>
    </head>
    <body data-signals="{active: 'Daily'}">
        <div id="rooms" data-init="@get('/rooms')"></div>
        <div id="chat" data-init="@get('/rooms/Daily/messages')"></div>
        <div data-init="@get('/sse', {openWhenHidden: true})"></div>
    </body>
</html>
}

templ RoomsComponent(rooms []string) {
  <aside id="rooms" class="sidebar" data-side="left">
    <nav aria-label="Chat rooms">
      <header>
        <h2 class="text-base font-semibold">Go Chat</h2>
      </header>
      <section class="scrollbar-sm">
        <div role="group" aria-labelledby="rooms-label">
          <h3 id="rooms-label">Rooms</h3>
          <ul>
            for _, room := range rooms {
              <li>
                <a
                  href="#"
                  data-ignore-current
                  data-on:click__prevent={"@get('/rooms/" + room + "/messages')"}
                  data-attr:aria-current={"$active == '" + room + "' && 'page'"}
                >
                  <span>{room}</span>
                </a>
              </li>
            }
          </ul>
        </div>
      </section>
    </nav>
  </aside>
}


templ MessageComponent(message Message) {
    <article id={message.Id} class="card !flex-row !gap-4 !py-3 items-baseline px-4">
      <span class="w-32 shrink-0 truncate text-sm font-semibold">{message.User}</span>
      <p class="min-w-0 flex-1 break-words">{message.Message}</p>
      <time class="shrink-0 text-xs tabular-nums text-muted-foreground">{message.Sent.Format("15:04")}</time>
    </article>
}

templ MessagesComponent(room string, messages []Message) {
  <main id="chat" class="flex h-screen flex-col">
    <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4 md:px-6">
      <button
        type="button"
        class="btn-icon-ghost md:hidden"
        aria-label="Toggle rooms"
        aria-controls="rooms"
        data-on:click="document.dispatchEvent(new CustomEvent('basecoat:sidebar', {detail: {id: 'rooms'}}))"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="18" x="3" y="3" rx="2"></rect>
          <path d="M9 3v18"></path>
        </svg>
      </button>
      <h1 class="text-base font-medium">{room}</h1>
    </header>

    <section id={room + "_messages"} class="scrollbar flex-1 space-y-2 overflow-y-auto p-4">
      for _, message := range messages {
        @MessageComponent(message)
      }
    </section>

    <footer class="shrink-0 border-t p-4">
      <form class="form flex items-center gap-2" data-on:submit={"@post('/rooms/" + room + "/messages', {contentType: 'form'})"}>
        <label for="message" class="sr-only">Message</label>
        <input
          id="message"
          name="message"
          type="text"
          class="input flex-1"
          data-bind:messageinput
          placeholder={"Message " + room}
          autocomplete="off"
        />
        <button type="submit" class="btn">Send</button>
      </form>
    </footer>
  </main>
}
