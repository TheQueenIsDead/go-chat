package web

templ Rooms(rooms []string) {
  <aside id="rooms" class="w-64 bg-gray-100 border-r p-4">
    <h2 class="text-xl font-bold mb-4">Rooms</h2>
    <ul class="space-y-2">
      for _, room := range rooms {
        <li><button class="w-full text-left px-3 py-2 rounded hover:bg-gray-200">{room}</button></li>
      }
    </ul>
  </aside>
}